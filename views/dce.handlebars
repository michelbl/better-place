<h1 class="ui header">Détails sur un DCE</h1>

<div class="ui list">
  <div class="item">Identifiant PLACE de l'annonce :
    {{place_metadata.annonce_id}}</div>
  <div class="item"><a href="{{betterplace_metadata.original_url}}">Lien
      original</a></div>
  <div class="item">Métadonnée "org_acronym" :
    {{place_metadata.org_acronym}}</div>
  <div class="item">Métadonnée "reference" : {{place_metadata.reference}}</div>
  <div class="item">Métadonnée "intitule" : {{place_metadata.intitule}}</div>
  <div class="item">Métadonnée "objet" : {{place_metadata.objet}}</div>
  <div class="item">Métadonnée "organisme" : {{place_metadata.organisme}}</div>
  {{#if place_metadata.date_limite_remise_plis}}
    <div class="item">Date limite de remise des plis :
      {{place_metadata.date_limite_remise_plis}}</div>
  {{/if}}
  {{#if place_metadata.entite_achat}}
    <div class="item">Entité d'achat : {{place_metadata.entite_achat}}</div>
  {{/if}}
  {{#if place_metadata.procedure}}
    <div class="item">Procédure : {{place_metadata.procedure}}</div>
  {{/if}}
  {{#if place_metadata.categorie_principale}}
    <div class="item">Catégorie principale :
      {{place_metadata.categorie_principale}}</div>
  {{/if}}
  {{#if place_metadata.allotissement}}
    <div class="item">Allotissement : {{place_metadata.allotissement}}</div>
  {{/if}}
  {{#if place_metadata.lieu_execution}}
    <div class="item">Lieu d'exécution : {{place_metadata.lieu_execution}}</div>
  {{/if}}
  {{#if place_metadata.code_cpv}}
    <div class="item">Code CPV : {{place_metadata.code_cpv}}</div>
  {{/if}}
  <div class="item">Date du téléchargement depuis PLACE :
    {{betterplace_metadata.fetch_datetime}}</div>
</div>

<h2 class="ui header">Avis</h2>

<p>Liens BOAMP :</p>
<div class="ui list">
  {{#each place_metadata.links_boamp}}
    <div class="item">
      <a href={{this}}>{{this}}</a>
    </div>
  {{/each}}
</div>

{{#if avis}}
  {{#with avis}}
    <a href={{href}}>{{filename}} ({{file_size}})</a>
    <div class="ui list">
      {{#each embedded_filenames}}
        <div class="item">
          {{this}}
        </div>
      {{/each}}
    </div>
  {{/with}}
{{else}}
  <p>Cette annonce de comprend pas d'avis.</p>
{{/if}}

<h2 class="ui header">Réglement</h2>

<p>Référence du réglement : {{place_metadata.reglement_ref}}</p>

{{#if reglement}}
  {{#with reglement}}
    <a href={{href}}>{{filename}} ({{file_size}})</a>
    <div class="ui list">
      {{#each embedded_filenames}}
        <div class="item">
          {{this}}
        </div>
      {{/each}}
    </div>
  {{/with}}
{{else}}
  <p>Cette annonce de comprend pas de réglement.</p>
{{/if}}

